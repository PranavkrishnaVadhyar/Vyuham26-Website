# --- Database (Supabase Postgres, pooled or direct) ---
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Supabase auth ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=replace-with-your-project-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# --- CORS: comma-separated allowed frontend origins ---
# Production must list the real deployed site origin(s), e.g.
# FRONTEND_ORIGINS=https://vyuham26.in,https://www.vyuham26.in
FRONTEND_ORIGINS=http://127.0.0.1:5500

# --- Admin access key (optional) ---
# Presented by the frontend as the X-Admin-Key header. Leave unset ("") to
# disable key-based admin access entirely (admin-role Supabase JWTs still work).
# Choose a strong random value that does NOT appear anywhere in the frontend
# source tree or bundle.
ADMIN_ACCESS_KEY=

# --- Initial seed for the registration gateway ---
# Only used the first time, before any admin has toggled the gate; afterwards
# the authoritative value lives in the site_settings DB table.
REG_OPEN=true
