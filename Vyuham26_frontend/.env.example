# Supabase (publishable values — safe to ship in the browser bundle)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Backend API origin used by src/lib/api.ts.
# - Development: put http://localhost:8000 in .env.development (loaded only by `vite dev`).
# - Production: set VITE_API_URL to your deployed API origin (e.g. https://api.example.com)
#   at BUILD time. If it is left unset the client falls back to same-origin requests,
#   which is the correct behaviour behind a reverse proxy / rewrites.
# Never put secrets here: everything in a VITE_* variable is public in the built bundle.
VITE_API_URL=
